# Company Brain v3 deployment env — copy to /opt/company-brain/infra/.env on
# the droplet and fill in real values. Never commit the populated .env file
# (the repo's root .gitignore already covers it).
#
# This file feeds `docker compose --env-file .env up -d`. Every required
# variable in docker-compose.yml has either a default here OR is marked
# `${VAR:?error}` upstream so compose refuses to start if missing.

# =========================================================================
# Postgres role passwords (generate with `openssl rand -hex 32`)
# =========================================================================
POSTGRES_ADMIN_PASSWORD=
POSTGRES_INGEST_PASSWORD=
POSTGRES_READER_PASSWORD=

# =========================================================================
# Embedding provider (gbrain ZeroEntropy switch)
# https://www.zeroentropy.dev/dashboard
# =========================================================================
ZEROENTROPY_API_KEY=

# =========================================================================
# LLM gateway (gbrain ask path; v3 doesn't ship /ask, kept for compatibility)
# https://console.anthropic.com/
# =========================================================================
ANTHROPIC_API_KEY=

# =========================================================================
# Microsoft 365 (Graph) — reuse the Play B app registration
# Azure Portal -> App registrations -> {your app} -> Overview
# =========================================================================
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_USER_PRINCIPAL_NAME=
M365_USER_PRINCIPAL_NAMES=

# =========================================================================
# Acumatica
# ACUMATICA_BRANCH_* values MUST match the Acumatica branch IDs exactly
# (case-sensitive). e.g. ACUMATICA_BRANCH_BLCS=BLC (not "bl").
# =========================================================================
ACUMATICA_BASE_URL=
ACUMATICA_ENDPOINT_VERSION=24.200.001
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_TENANT=Production
ACUMATICA_BRANCH_FS=
ACUMATICA_BRANCH_BLCS=
ACUMATICA_BRANCH_USA=

# =========================================================================
# Pipedrive
# Settings -> Personal preferences -> API in Pipedrive web UI
# =========================================================================
PIPEDRIVE_API_TOKEN_FS=
PIPEDRIVE_API_TOKEN_BLCS_USA=
PIPEDRIVE_COMPANY_DOMAIN=
PIPEDRIVE_COMPANY_DOMAIN_FS=
PIPEDRIVE_COMPANY_DOMAIN_BLCS_USA=

# =========================================================================
# Supermemory (Layer 5 feedback loop)
# https://supermemory.ai
# =========================================================================
SUPERMEMORY_API_KEY=

# =========================================================================
# Scheduler behavior (defaults at the bottom of docker-compose.yml)
# =========================================================================
SCHEDULER_DRY_RUN=false
SCHEDULER_NO_EMBED=false
# Optional comma-separated list, e.g. "acumatica-fs,m365-mail". Empty = all.
SCHEDULER_SOURCES=

# =========================================================================
# Cloudflare Tunnel
# =========================================================================
# Token from Cloudflare Zero Trust tunnel setup. Do not commit the live value.
CLOUDFLARED_TOKEN=
