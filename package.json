{
  "name": "company-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "bun run src/cli/ingest.ts",
    "ask": "bun run src/cli/ask.ts",
    "search": "bun run src/cli/search.ts",
    "eval:answers": "bun run src/cli/answer-eval.ts",
    "eval:citations": "bun run src/cli/citation-eval.ts",
    "fixtures:check": "bun run src/cli/fixture-check.ts",
    "provenance:check": "bun run src/cli/provenance-check.ts",
    "source-health:check": "bun run src/cli/source-health-check.ts",
    "source-isolation:check": "bun run src/cli/source-isolation-check.ts",
    "live-readiness:check": "bun run src/cli/live-readiness-check.ts",
    "static:check": "bun run src/cli/static-site-check.ts",
    "static:seed-fixtures": "bun run src/cli/static-fixture-seed.ts",
    "doctor": "bun run src/cli/doctor.ts",
    "status": "bun run src/cli/status.ts",
    "smoke": "bun run src/cli/smoke.ts",
    "smoke:api": "bun run src/cli/api-smoke.ts",
    "ingest:fixtures": "bun run src/cli/ingest-fixtures.ts",
    "api": "bun run src/api/server.ts",
    "acumatica:readiness": "bun run src/cli/acumatica-readiness.ts",
    "pagegen": "bun run src/page-gen/index.ts",
    "query": "bun run src/query/server.ts",
    "scheduler": "bun run src/scheduler/index.ts",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "typecheck": "bun --bun tsc -p . --noEmit"
  },
  "dependencies": {
    "gbrain": "github:garrytan/gbrain#32f8be9",
    "hono": "^4.6.10",
    "@hono/node-server": "^1.13.7",
    "node-cron": "^3.0.3",
    "@azure/msal-node": "^2.16.2",
    "marked": "^18.0.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
