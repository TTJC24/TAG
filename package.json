{
  "name": "tractionos",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "setup:clerk": "tsx --env-file=.env.local scripts/clerk-setup.ts",
    "setup:clerk-admin": "tsx --env-file=.env.local scripts/clerk-add-admin.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.34.0",
    "@clerk/nextjs": "^6.39.3",
    "@google/generative-ai": "^0.21.0",
    "@liveblocks/client": "^2.24.4",
    "@liveblocks/node": "^2.24.4",
    "@liveblocks/react": "^2.24.4",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "geist": "^1.3.1",
    "groq-sdk": "^0.9.1",
    "lucide-react": "^0.469.0",
    "next": "14.2.18",
    "next-themes": "^0.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "allowBuilds": {
      "esbuild": true,
      "unrs-resolver": true,
      "@clerk/shared": true
    }
  }
}
