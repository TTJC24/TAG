# Copy to .env.production on the droplet, fill every value, chmod 600.
# NOTHING here has a default; first boot fails loudly on anything missing.

# Postgres admin (owns schema, runs migrations; app services never use it)
POSTGRES_DB=operating_layer
POSTGRES_USER=operating_layer_admin
POSTGRES_PASSWORD=

# Runtime roles (RLS-forced, non-owner; the boot assertion enforces this)
RUNTIME_DB_PASSWORD=
WORKER_DB_PASSWORD=

# The owner account, seeded as admin of every organization on first boot.
# Must be the email Cloudflare Access authenticates.
OWNER_EMAIL=
OWNER_NAME=

# Cloudflare tunnel token for this app's tunnel (Zero Trust dashboard)
TUNNEL_TOKEN=

# Connector credential envelope keys (per docs/runbook.md key generation)
CONNECTOR_CREDENTIAL_PUBLIC_KEY_DER_B64=
CONNECTOR_CREDENTIAL_PRIVATE_KEY_DER_B64=

# Everything below stays OFF until deliberately enabled (see .env.example
# for the full catalog of switches: MODEL_PROVIDER/COMPANY_BRAIN_URL,
# TRACTION_BRIDGE_*, KPI_EXCEPTIONS_*, DEMANDSTAR_BRIDGE_*, MAIL_*).
MODEL_PROVIDER=deterministic

# --- Collections (Acumatica AR -> governed, drafted chases) -----------------
# Read-only ERP access. Acumatica is the source of truth; nothing is written
# back. Every chase this raises still requires human approval to go anywhere.
COLLECTIONS_ENABLED=false
COLLECTIONS_USER_EMAIL=
ACUMATICA_BASE_URL=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_COMPANY=Production
# ACUMATICA_ENDPOINT_VERSION=24.200.001
# Ignore trivial balances (dollars). Unset = chase everything past due.
# COLLECTIONS_MIN_PAST_DUE=250
# Signature on the drafted chase. A customer reads this, so use a real person;
# unset signs off as "Accounts Receivable" rather than a placeholder name.
# COLLECTIONS_SENDER_NAME=
# COLLECTIONS_SENDER_CONTACT=

# --- Daily auto-refresh ------------------------------------------------------
# "HH:MM" in UTC. Unset = no schedule (the worker behaves exactly as before);
# a malformed value is treated as unset, never as midnight. Note these are
# fixed in UTC and do not follow daylight-saving changes.
# COLLECTIONS_SCHEDULE_UTC=11:00
# SALES_SCHEDULE_UTC=11:30
