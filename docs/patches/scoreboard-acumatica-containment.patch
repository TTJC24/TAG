diff --git a/tests/test_acumatica_containment.py b/tests/test_acumatica_containment.py
new file mode 100644
index 0000000..347da2c
--- /dev/null
+++ b/tests/test_acumatica_containment.py
@@ -0,0 +1,385 @@
+"""Containment tests for the 2026-07-31 Acumatica account lockout.
+
+These assert the number of NETWORK CALLS, not just outcomes. The failure being
+guarded against costs a production ERP account, and "it returned an error" is
+compatible with having spent three login attempts on the way there.
+"""
+
+import json
+from urllib import error
+
+import pytest
+
+from backend.scoreboard.connectors.acumatica import (
+    FORBIDDEN,
+    RATE_LIMITED,
+    SERVER_ERROR,
+    TRANSPORT,
+    UNAUTHORIZED,
+    AcumaticaClient,
+    _classify,
+)
+from backend.scoreboard.connectors.acumatica_cache import AcumaticaCache, CachedAcumaticaReader
+from backend.scoreboard.connectors.auth_guard import AuthLatch
+
+
+class CountingOpener:
+    """Stands in for the urllib opener and counts every request it is given."""
+
+    def __init__(self, exc=None):
+        self.calls = []
+        self._exc = exc
+
+    def open(self, req, timeout=None):  # noqa: A003 - urllib interface
+        self.calls.append(req.full_url)
+        if self._exc is not None:
+            raise self._exc
+        raise AssertionError("unexpected network call")
+
+    @property
+    def login_calls(self):
+        return [c for c in self.calls if "/entity/auth/login" in c]
+
+
+def rejection(code=401):
+    return error.HTTPError(
+        "https://example.acumatica.com/entity/auth/login", code, "Unauthorized", {}, None
+    )
+
+
+@pytest.fixture
+def latch(tmp_path):
+    """A latch isolated to this test, standing in for the shared state file."""
+    return AuthLatch(tmp_path / "auth-latch.json")
+
+
+def make_client(latch, opener=None, **kwargs):
+    defaults = dict(
+        base_url="https://example.acumatica.com",
+        username="svc",
+        password="secret",
+        company="Production",
+        timeout_seconds=5,
+        auth_path="/entity/auth/login",
+        enabled=True,
+        allow_authentication=True,
+        latch=latch,
+    )
+    defaults.update(kwargs)
+    client = AcumaticaClient(**defaults)
+    if opener is not None:
+        client._opener = opener
+    client.backoff_seconds = 0
+    return client
+
+
+# --- gap 1: the latch must survive per-request client construction -----------
+
+
+def test_ten_independent_clients_across_ten_requests_make_one_login(latch, tmp_path):
+    """The real deployment shape: a NEW client per inbound HTTP request.
+
+    This is the test that would have caught the insufficiency of the first fix.
+    An instance-level latch passes 'ten calls on one client'; it fails here,
+    because each simulated request throws its client away. Only shared,
+    persistent state survives.
+    """
+    opener = CountingOpener(rejection(401))
+
+    for _ in range(10):
+        # Each iteration is a separate HTTP request: fresh client, fresh
+        # opener state, nothing carried over but the latch file.
+        client = make_client(latch, opener=CountingOpener(rejection(401)))
+        client._opener = opener
+        result = client.authenticate()
+        assert "fail_state" in result
+
+    assert len(opener.login_calls) == 1, (
+        f"expected exactly ONE network login across ten requests, "
+        f"got {len(opener.login_calls)}"
+    )
+    assert latch.is_latched()
+
+
+def test_latch_survives_a_process_restart(latch, tmp_path):
+    # A new AuthLatch object reading the same path stands in for a restarted
+    # process or a sibling container.
+    make_client(latch, opener=CountingOpener(rejection(401))).authenticate()
+
+    reopened = AuthLatch(latch.path)
+    assert reopened.is_latched()
+
+    opener = CountingOpener(rejection(401))
+    make_client(reopened, opener=opener).authenticate()
+    assert opener.login_calls == []
+
+
+def test_a_later_success_does_not_clear_a_latch(latch):
+    latch.record_failure("credential rejected")
+    latch.record_success()
+    assert latch.is_latched(), "only an operator may clear a latch"
+
+
+def test_only_an_operator_clears_the_latch(latch):
+    latch.record_failure("credential rejected")
+    latch.clear_by_operator("admin")
+    assert not latch.is_latched()
+
+
+def test_login_is_attempted_exactly_once_not_three_times(latch):
+    """The lockout signature: retries=2 fed range(retries+1) via the shared
+    read-retry wrapper, so ONE request produced THREE failed logins."""
+    opener = CountingOpener(rejection(401))
+    make_client(latch, opener=opener).authenticate()
+    assert len(opener.login_calls) == 1
+
+
+# --- gap 2: on-demand authentication is prohibited outright -----------------
+
+
+def test_authentication_is_denied_by_default(latch):
+    opener = CountingOpener(rejection(401))
+    client = make_client(latch, opener=opener, allow_authentication=False)
+    result = client.authenticate()
+    assert "fail_state" in result
+    assert "prohibited" in result["fail_state"]["reason"].lower()
+    assert opener.calls == []
+
+
+def test_reads_never_authenticate_implicitly(latch):
+    """A read on an unauthenticated client must NOT log in.
+
+    Implicit authentication in _read_domain is what made every data endpoint a
+    credential attempt.
+    """
+    opener = CountingOpener(rejection(401))
+    client = make_client(latch, opener=opener)
+    result = client.fetch_branches("/entity/Default/24.200.001/Branch")
+    assert "fail_state" in result
+    assert opener.calls == [], "a read must never trigger a login"
+
+
+def test_disabled_connector_never_touches_the_network(latch):
+    opener = CountingOpener(rejection(401))
+    client = make_client(latch, opener=opener, enabled=False)
+    assert "fail_state" in client.authenticate()
+    assert "fail_state" in client.fetch_branches("/x")
+    assert opener.calls == []
+
+
+def test_enabled_flag_defaults_to_disabled(monkeypatch, latch):
+    monkeypatch.delenv("SCOREBOARD_ACUMATICA_ENABLED", raising=False)
+    assert make_client(latch, enabled=None).enabled is False
+    for value in ["TRUE", "True", "1", "yes", "on", " true", ""]:
+        monkeypatch.setenv("SCOREBOARD_ACUMATICA_ENABLED", value)
+        assert make_client(latch, enabled=None).enabled is False, value
+    monkeypatch.setenv("SCOREBOARD_ACUMATICA_ENABLED", "true")
+    assert make_client(latch, enabled=None).enabled is True
+
+
+# --- gap 4: read retries are classified -------------------------------------
+
+
+def test_401_and_403_are_never_retried(latch):
+    for code in (401, 403):
+        opener = CountingOpener(rejection(code))
+        client = make_client(latch, opener=opener)
+        client._authenticated = True
+        result = client.fetch_branches("/x")
+        assert "fail_state" in result
+        assert len(opener.calls) == 1, f"HTTP {code} must not be retried"
+        assert "not retryable" in result["fail_state"]["reason"]
+
+
+def test_transport_and_server_errors_retry_but_are_bounded(latch):
+    for exc in (rejection(500), error.URLError("connection reset")):
+        opener = CountingOpener(exc)
+        client = make_client(latch, opener=opener)
+        client._authenticated = True
+        client.fetch_branches("/x")
+        # retries=2 → three attempts, and no more.
+        assert len(opener.calls) == 3
+
+
+def test_429_is_retried_using_its_own_retry_after(latch):
+    exc = error.HTTPError("https://x/y", 429, "Too Many", {"Retry-After": "7"}, None)
+    kind, wait = _classify(exc, backoff_seconds=0.5, attempt=0)
+    assert kind is RATE_LIMITED
+    assert kind.retryable
+    assert wait == 7.0
+
+
+def test_429_retry_after_is_capped(latch):
+    exc = error.HTTPError("https://x/y", 429, "Too Many", {"Retry-After": "3600"}, None)
+    _, wait = _classify(exc, backoff_seconds=0.5, attempt=0)
+    assert wait == 30.0, "an hour-long sleep inside a request is our own outage"
+
+
+def test_429_without_retry_after_falls_back_to_backoff(latch):
+    exc = error.HTTPError("https://x/y", 429, "Too Many", {}, None)
+    _, wait = _classify(exc, backoff_seconds=0.5, attempt=1)
+    assert wait == 1.0
+
+
+def test_429_with_http_date_retry_after_falls_back_safely(latch):
+    # HTTP-date form is not parsed; mis-parsing into 0 or a huge value is worse
+    # than using ordinary backoff.
+    exc = error.HTTPError(
+        "https://x/y", 429, "Too Many", {"Retry-After": "Wed, 21 Oct 2026 07:28:00 GMT"}, None
+    )
+    _, wait = _classify(exc, backoff_seconds=0.5, attempt=0)
+    assert wait == 0.5
+
+
+def test_classification_of_each_kind():
+    assert _classify(rejection(401), 0.5, 0)[0] is UNAUTHORIZED
+    assert _classify(rejection(403), 0.5, 0)[0] is FORBIDDEN
+    assert _classify(rejection(500), 0.5, 0)[0] is SERVER_ERROR
+    assert _classify(error.URLError("boom"), 0.5, 0)[0] is TRANSPORT
+    assert not UNAUTHORIZED.retryable
+    assert not FORBIDDEN.retryable
+    assert RATE_LIMITED.retryable
+    assert SERVER_ERROR.retryable
+    assert TRANSPORT.retryable
+
+
+# --- gap 3 + 5: no externally callable route may authenticate ---------------
+
+
+ROUTES = [
+    "leadership_flash",
+    "sales_scoreboard",
+    "financial_revenue_by_rep",
+    "financial_margin_by_rep",
+    "financial_validation_status",
+    "stale_opportunities",
+    "stuck_orders",
+    "platform_status",
+    "connector_status",
+]
+
+
+class ExplodingOpener:
+    """Any network call at all is a test failure."""
+
+    def __init__(self):
+        self.calls = []
+
+    def open(self, req, timeout=None):  # noqa: A003
+        self.calls.append(req.full_url)
+        raise AssertionError(f"route made a network call to {req.full_url}")
+
+
+@pytest.fixture
+def no_acumatica_network(monkeypatch, tmp_path):
+    """Make ANY Acumatica network call fail loudly, and isolate all state.
+
+    Acumatica settings are populated with plausible values ON PURPOSE. Without
+    them `Settings.from_env()` yields blanks, `authenticate()` short-circuits on
+    "credentials not fully configured", and the whole suite passes because
+    nothing *could* have reached the network — a test that proves the test
+    environment is empty, not that the routes are safe. Verified by regression:
+    with these set, a route that authenticates is caught; without them, it is
+    not.
+    """
+    monkeypatch.setenv("SCOREBOARD_ACUMATICA_STATE_DIR", str(tmp_path / "state"))
+    monkeypatch.setenv("SCOREBOARD_ACUMATICA_CACHE_DIR", str(tmp_path / "cache"))
+    monkeypatch.setenv("ACUMATICA_BASE_URL", "https://example.acumatica.com")
+    monkeypatch.setenv("ACUMATICA_USERNAME", "svc")
+    monkeypatch.setenv("ACUMATICA_PASSWORD", "secret")
+    monkeypatch.setenv("ACUMATICA_COMPANY", "Production")
+
+    opener = ExplodingOpener()
+    # Every AcumaticaClient built anywhere gets the exploding opener, so a route
+    # that constructs one and authenticates cannot pass this test quietly.
+    original_init = AcumaticaClient.__init__
+
+    def patched_init(self, *args, **kwargs):
+        original_init(self, *args, **kwargs)
+        self._opener = opener
+
+    monkeypatch.setattr(AcumaticaClient, "__init__", patched_init)
+    return opener
+
+
+@pytest.mark.parametrize("route_name", ROUTES)
+@pytest.mark.parametrize("flag", [None, "true"])
+def test_no_route_makes_an_acumatica_request(route_name, flag, no_acumatica_network, monkeypatch):
+    """Gap 5: every externally callable route, zero Acumatica requests.
+
+    Run with the integration flag DISABLED (the required condition) and also
+    ENABLED. The second case is the stronger property and the one that matters
+    long-term: routes must not authenticate even when Acumatica is fully
+    switched on, because the prohibition is structural — they hold a
+    cache-backed reader with no credential — rather than a consequence of the
+    kill switch being off. A guarantee that only holds while the feature is
+    disabled is not a guarantee.
+    """
+    from backend.scoreboard.api import routes
+
+    if flag is None:
+        monkeypatch.delenv("SCOREBOARD_ACUMATICA_ENABLED", raising=False)
+    else:
+        monkeypatch.setenv("SCOREBOARD_ACUMATICA_ENABLED", flag)
+
+    route = getattr(routes, route_name)
+    try:
+        route()
+    except Exception as exc:  # noqa: BLE001 - a route may fail for unrelated reasons
+        assert not isinstance(exc, AssertionError), str(exc)
+
+    assert no_acumatica_network.calls == [], (
+        f"{route_name} made {len(no_acumatica_network.calls)} Acumatica request(s) "
+        f"with SCOREBOARD_ACUMATICA_ENABLED={flag!r}"
+    )
+
+
+def test_route_list_is_complete():
+    """Guard against a new public route escaping the check above."""
+    from backend.scoreboard.api import routes
+
+    public = {
+        name
+        for name in dir(routes)
+        if not name.startswith("_")
+        and callable(getattr(routes, name))
+        and getattr(getattr(routes, name), "__module__", "") == routes.__name__
+    }
+    assert public == set(ROUTES), (
+        f"routes not covered by the no-authentication test: {sorted(public - set(ROUTES))}"
+    )
+
+
+def test_routes_use_a_cache_backed_reader_with_no_credential(no_acumatica_network):
+    from backend.scoreboard.api import routes
+
+    _, _, acumatica, _, _ = routes._build_dependencies()
+    assert isinstance(acumatica, CachedAcumaticaReader)
+    # It structurally cannot authenticate: no credential, no opener.
+    assert not hasattr(acumatica, "password")
+    assert not hasattr(acumatica, "_opener")
+    assert "fail_state" in acumatica.authenticate()
+
+
+def test_status_snapshot_reports_a_cache_miss_rather_than_empty_data(tmp_path):
+    reader = CachedAcumaticaReader(cache=AcumaticaCache(tmp_path / "empty"))
+    branches = reader.fetch_branches("/x")
+    assert branches["cache_state"] == "miss"
+    assert "fail_state" in branches, "a miss must not masquerade as an empty result set"
+
+
+def test_cache_round_trip_reports_age(tmp_path):
+    cache = AcumaticaCache(tmp_path / "cache")
+    cache.write("branches", {"records": [{"BranchCD": "FS"}], "as_of": "2026-07-31T00:00:00+00:00"})
+    reader = CachedAcumaticaReader(cache=cache)
+    payload = reader.fetch_branches("/x")
+    assert payload["cache_state"] == "hit"
+    assert payload["records"] == [{"BranchCD": "FS"}]
+    assert payload["age_seconds"] is not None
+
+
+def test_status_snapshot_discloses_no_credential(tmp_path):
+    reader = CachedAcumaticaReader(cache=AcumaticaCache(tmp_path / "c"))
+    blob = json.dumps(reader.status_snapshot())
+    for secret in ("secret", "svc", "password"):
+        assert secret not in blob
