diff --git a/backend/scoreboard/connectors/acumatica.py b/backend/scoreboard/connectors/acumatica.py
index 0ec154d..a8c8167 100644
--- a/backend/scoreboard/connectors/acumatica.py
+++ b/backend/scoreboard/connectors/acumatica.py
@@ -1,4 +1,5 @@
 import json
+import os
 import time
 from datetime import datetime, timezone
 from http import cookiejar
@@ -9,8 +10,42 @@ from backend.scoreboard.connectors.base import ConnectorContext
 from backend.scoreboard.models.types import FailState
 
 
+def _env_enabled() -> bool:
+    """Kill switch. Defaults to DISABLED — see the class docstring."""
+    return os.getenv("SCOREBOARD_ACUMATICA_ENABLED", "") == "true"
+
+
 class AcumaticaClient:
-    """Read-only Acumatica connector for v1 integration plumbing."""
+    """Read-only Acumatica connector for v1 integration plumbing.
+
+    CONTAINMENT NOTES (2026-07-31 incident)
+    ---------------------------------------
+    This client is the leading suspect in an Acumatica account lockout. The
+    account (`agent.scoreboard`) recorded exactly three failed password attempts
+    at the moment of lockout, about ten hours after the password was rotated.
+    Three is this client's signature: `retries=2` fed `range(retries + 1)`, and
+    `authenticate()` went through the same retry wrapper as every data read, so
+    one request carrying a stale password produced three `POST
+    /entity/auth/login` calls roughly 1.5 seconds apart.
+
+    Three changes address that:
+
+    1. **Authentication is never retried.** A rejected credential is a fact, not
+       a transient error, and repeating it only spends attempts against a
+       lockout threshold.
+    2. **A failed authentication latches for the life of the process.** Removing
+       retries alone is NOT sufficient: this client was constructed per HTTP
+       request, so an endpoint polled every 30 seconds would still produce one
+       failed login per poll and reach the threshold within minutes. After a
+       rejection, later calls fail locally without touching the network.
+    3. **The connector is disabled by default.** `SCOREBOARD_ACUMATICA_ENABLED`
+       must be exactly "true" or nothing here contacts Acumatica at all. This is
+       the containment switch, and it fails closed: a deploy that forgets to set
+       it cannot resume authenticating.
+
+    Status and health endpoints must use `status_snapshot()`, which reports what
+    is known WITHOUT authenticating.
+    """
 
     def __init__(
         self,
@@ -22,15 +57,20 @@ class AcumaticaClient:
         auth_path: str,
         retries: int = 2,
         backoff_seconds: float = 0.5,
+        enabled: bool | None = None,
     ) -> None:
         self.context = ConnectorContext(source="acumatica", base_url=base_url.rstrip("/"), timeout_seconds=timeout_seconds)
         self.username = username
         self.password = password
         self.company = company
         self.auth_path = auth_path
+        # Retries apply to DATA READS only. Authentication passes retries=0
+        # explicitly; see authenticate().
         self.retries = retries
         self.backoff_seconds = backoff_seconds
+        self.enabled = _env_enabled() if enabled is None else enabled
         self._authenticated = False
+        self._auth_failed_reason: str | None = None
         self._opener = request.build_opener(request.HTTPCookieProcessor(cookiejar.CookieJar()))
 
     def _url(self, path: str) -> str:
@@ -49,7 +89,18 @@ class AcumaticaClient:
             "fail_state": FailState(reason=reason, source=self.context.source, as_of=now).to_dict(),
         }
 
-    def _request_json(self, method: str, path: str, domain: str, payload: dict[str, Any] | None = None) -> dict[str, Any]:
+    def _request_json(
+        self,
+        method: str,
+        path: str,
+        domain: str,
+        payload: dict[str, Any] | None = None,
+        retries: int | None = None,
+    ) -> dict[str, Any]:
+        # `retries` is an explicit per-call override so authentication can opt
+        # out of retrying while data reads keep it. Previously both shared
+        # self.retries, which is how one request became three login attempts.
+        attempts = self.retries if retries is None else retries
         url = self._url(path)
         body = None if payload is None else json.dumps(payload).encode("utf-8")
         headers = {"Accept": "application/json"}
@@ -57,7 +108,7 @@ class AcumaticaClient:
             headers["Content-Type"] = "application/json"
 
         last_error: Exception | None = None
-        for attempt in range(self.retries + 1):
