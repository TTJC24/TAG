+def _classify(exc: Exception, backoff_seconds: float, attempt: int) -> tuple[_FailureKind, float]:
+    """Classify a failure and say how long to wait before any retry."""
+    default_wait = backoff_seconds * (2**attempt)
+    if isinstance(exc, error.HTTPError):
+        if exc.code == 401:
+            return UNAUTHORIZED, 0.0
+        if exc.code == 403:
+            return FORBIDDEN, 0.0
+        if exc.code == 429:
+            # Honour the server's own guidance when it gives any, bounded.
+            supplied = _retry_after_seconds(exc)
+            wait = default_wait if supplied is None else min(supplied, MAX_RETRY_AFTER_SECONDS)
