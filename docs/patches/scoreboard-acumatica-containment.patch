diff --git a/backend/scoreboard/cli/refresh_acumatica.py b/backend/scoreboard/cli/refresh_acumatica.py
new file mode 100644
index 0000000..3b64282
--- /dev/null
+++ b/backend/scoreboard/cli/refresh_acumatica.py
@@ -0,0 +1,89 @@
+"""The ONLY code path permitted to authenticate to Acumatica.
+
+    python -m backend.scoreboard.cli.refresh_acumatica
+
+Every HTTP route serves cached last-known state via ``CachedAcumaticaReader``
+and cannot reach the network. This job holds the credential, authenticates
+once, reads, writes the cache, and exits.
+
+Guards, in order:
+
+  1. ``SCOREBOARD_ACUMATICA_ENABLED`` must be exactly ``"true"``. Fails closed.
+  2. The shared, persistent auth latch must be clear. One rejected credential
+     stops every process and container pointed at the same state directory,
+     across restarts, until an operator clears it deliberately.
+  3. Exactly ONE login attempt. No retry — a rejected credential is a fact, and
+     each repeat spends another attempt against the account lockout threshold.
+
+Exits non-zero on any failure so a scheduler surfaces it rather than swallowing
+it. It does not reschedule itself and does not retry.
+"""
+
+from __future__ import annotations
+
+import sys
+
+from backend.scoreboard.config import Settings
+from backend.scoreboard.connectors.acumatica import AcumaticaClient
+from backend.scoreboard.connectors.acumatica_cache import AcumaticaCache
+from backend.scoreboard.connectors.auth_guard import AuthLatch
+
+
+def refresh(settings: Settings | None = None, cache: AcumaticaCache | None = None) -> int:
+    settings = settings or Settings.from_env()
+    cache = cache or AcumaticaCache()
+    latch = AuthLatch()
+
+    client = AcumaticaClient(
+        base_url=settings.acumatica_base_url,
+        username=settings.acumatica_username,
+        password=settings.acumatica_password,
+        company=settings.acumatica_company,
+        timeout_seconds=settings.acumatica_timeout_seconds,
+        auth_path=settings.acumatica_auth_path,
+        # The single opt-in. No other construction site sets this.
+        allow_authentication=True,
+        latch=latch,
+    )
+
+    print(f"auth latch coordination: {latch.coordination_scope()}")
+
+    auth = client.authenticate()
+    if auth.get("authenticated") is not True:
+        reason = (auth.get("fail_state") or {}).get("reason", "unknown")
+        print(f"REFUSED/FAILED: {reason}", file=sys.stderr)
+        # No retry, no second attempt, no fallback. If this was a rejection the
+        # latch is now set and the next run will refuse before touching the
+        # network.
+        return 1
+
+    domains = [
+        ("branches", lambda: client.fetch_branches(settings.acumatica_branches_path)),
+        ("sales_orders", lambda: client.fetch_sales_orders(settings.acumatica_sales_orders_path)),
+        ("ar_invoices", lambda: client.fetch_ar_invoices(settings.acumatica_ar_invoices_path)),
+        ("inventory_dead_stock", lambda: client.fetch_inventory_dead_stock_candidates(settings.acumatica_inventory_path)),
+    ]
+
+    failures = 0
+    for name, read in domains:
+        payload = read()
+        if "fail_state" in payload:
+            reason = (payload.get("fail_state") or {}).get("reason", "unknown")
+            print(f"  {name}: FAILED — {reason}", file=sys.stderr)
+            failures += 1
+            # Deliberately not cached. Overwriting good cached data with a
+            # failure would turn one bad read into a dashboard outage; routes
+            # keep serving the previous snapshot, labelled with its age.
+            continue
+        cache.write(name, payload)
+        print(f"  {name}: cached {len(payload.get('records', []))} record(s)")
+
+    return 1 if failures else 0
+
+
+def main() -> int:
+    return refresh()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
