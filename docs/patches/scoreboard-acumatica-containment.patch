index 0000000..a4a4cd7
--- /dev/null
+++ b/backend/scoreboard/connectors/auth_guard.py
@@ -0,0 +1,119 @@
+"""Shared, persistent authentication guard for the Acumatica account.
+
+Why this is a file and not an instance attribute
+------------------------------------------------
+The first containment attempt latched a failed authentication on the client
+object. That was not enough, for a reason worth stating precisely: this service
+constructs a new ``AcumaticaClient`` on every HTTP request, and may run several
+worker processes or containers. A latch that lives on the object dies with the
+request; a latch that lives in module state dies with the process; and neither
+is visible to a sibling container.
+
+The thing being protected — the account's failed-attempt counter — is global to
+the Acumatica tenant. A guard protecting it must be at least as global as it is.
+
+So the latch is a file. Point every process and container at the same path
+(a shared volume, or a host bind mount) and one rejected credential stops all of
+them. If they somehow do not share it, the guard degrades to per-process, which
+is strictly better than nothing but is NOT the intended deployment — see
+``coordination_scope()``.
+
+Nothing in the runtime clears this. No retry, no restart, no redeploy, no later
+success. Only ``clear_by_operator``, invoked deliberately.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+DEFAULT_STATE_DIR = "/var/lib/scoreboard/acumatica"
+
+
+def state_path() -> Path:
+    """Where the latch lives. Override with SCOREBOARD_ACUMATICA_STATE_DIR."""
+    return Path(os.getenv("SCOREBOARD_ACUMATICA_STATE_DIR", DEFAULT_STATE_DIR)) / "auth-latch.json"
+
+
+class AuthLatch:
+    """Persistent record of a rejected Acumatica credential."""
+
+    def __init__(self, path: Path | None = None) -> None:
+        self.path = path or state_path()
+
+    def read(self) -> dict[str, Any]:
+        try:
+            with self.path.open("r", encoding="utf-8") as handle:
+                data = json.load(handle)
+            return data if isinstance(data, dict) else {}
+        except (OSError, ValueError):
+            # An unreadable latch is treated as clear rather than crashing the
+            # service. The prohibition on route-initiated authentication is the
+            # primary control; this is the backstop, and a backstop that takes
+            # the service down is its own outage.
+            return {}
+
+    def is_latched(self) -> bool:
+        return bool(self.read().get("latched"))
+
+    def record_failure(self, reason: str) -> dict[str, Any]:
+        state = {
+            "latched": True,
+            "reason": reason,
+            "at": datetime.now(timezone.utc).isoformat(),
+            "pid": os.getpid(),
+        }
+        self._write(state)
+        return state
+
+    def record_success(self) -> None:
+        # A success does NOT clear an existing latch. If a credential was
+        # rejected, an operator decides whether the cause is understood — one
+        # lucky success does not establish that.
+        if self.is_latched():
+            return
+        self._write(
+            {
+                "latched": False,
+                "reason": "",
+                "last_success_at": datetime.now(timezone.utc).isoformat(),
+            }
+        )
+
+    def clear_by_operator(self, who: str) -> dict[str, Any]:
+        """The only way a latch is released. Nothing in the runtime calls this."""
+        state = {
+            "latched": False,
+            "reason": f"cleared by {who} at {datetime.now(timezone.utc).isoformat()}",
+        }
+        self._write(state)
+        return state
+
+    def _write(self, state: dict[str, Any]) -> None:
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            with self.path.open("w", encoding="utf-8") as handle:
+                json.dump(state, handle, indent=2)
+        except OSError:
+            # Best effort. If the latch cannot be persisted, say so loudly via
+            # coordination_scope() rather than pretending coordination exists.
+            pass
+
+    def coordination_scope(self) -> str:
+        """Whether this latch actually coordinates across processes.
+
+        Returned in status payloads so an operator can see, from the running
+        service, whether the guard is shared or has silently degraded to
+        per-process — a distinction that is invisible until it matters.
+        """
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            probe = self.path.parent / ".write-probe"
+            probe.write_text("ok", encoding="utf-8")
+            probe.unlink()
+            return f"shared:{self.path.parent}"
+        except OSError:
+            return "process-local-only:state directory is not writable"
