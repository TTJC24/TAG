diff --git a/backend/scoreboard/api/routes.py b/backend/scoreboard/api/routes.py
index 21d1aa7..06ca84a 100644
--- a/backend/scoreboard/api/routes.py
+++ b/backend/scoreboard/api/routes.py
@@ -118,7 +118,19 @@ def platform_status() -> dict:
     settings, pipedrive, acumatica, service, _ = _build_dependencies()
     activities = _records(pipedrive.fetch_activities(settings.pipedrive_activities_path))
     deals = _records(pipedrive.fetch_deals(settings.pipedrive_deals_path))
-    branches = _records(acumatica.fetch_branches(settings.acumatica_branches_path))
+    # Deliberately does NOT read branches from Acumatica.
+    #
+    # This is a status endpoint — the kind of thing a monitor or dashboard polls
+    # on a timer. It used to call fetch_branches(), which authenticates from
+    # scratch, so every poll was a credential attempt. Against a stale password
+    # that turns routine monitoring into an account lockout, which is the
+    # 2026-07-31 incident.
+    #
+    # Branch-mapping completeness is now reported from configuration alone.
+    # Checking it against live branch codes requires a real read, and that
+    # belongs in a data endpoint an operator invokes, not in a health check.
+    acumatica_status = acumatica.status_snapshot()
+    branches: list[dict] = []
 
     runtime_branch_codes = [str(row.get("BranchCD") or row.get("branch_code") or row.get("id") or "") for row in branches]
     runtime_rep_names = [
@@ -127,24 +139,31 @@ def platform_status() -> dict:
     ]
     unmapped_branches = service.normalization.unmapped_branch_codes(runtime_branch_codes)
     unmapped_reps = service.normalization.unmapped_rep_names(runtime_rep_names)
-    branch_mapping_complete = settings.branch_scope_configured and not unmapped_branches
     rep_mapping_complete = bool(settings.rep_mapping) and not unmapped_reps
 
+    # An empty branch list is NOT evidence that every branch is mapped. Since
+    # this endpoint no longer reads branches, it must say the check did not run
+    # rather than let "no unmapped branches found" pass for "all branches
+    # mapped" — a status endpoint that reports unearned green is worse than one
+    # that reports unknown.
+    branch_mapping_state = "not_verified_no_acumatica_read"
+
     item = KpiEnvelope(
         name="Certification Status",
         source_system="system",
         value={
             "branch_scope": "configured" if settings.branch_scope_configured else "missing",
-            "branch_mapping_state": "governed_complete" if branch_mapping_complete else "governed_incomplete",
+            "branch_mapping_state": branch_mapping_state,
             "rep_mapping_state": "governed_complete" if rep_mapping_complete else "governed_incomplete",
             "mapping_completeness": {
-                "branch_mapping_complete": branch_mapping_complete,
+                "branch_mapping_complete": None,
                 "rep_mapping_complete": rep_mapping_complete,
             },
             "unmapped_exceptions": {
-                "branches": unmapped_branches,
+                "branches": None,
                 "reps": unmapped_reps,
             },
+            "acumatica_connector": acumatica_status,
             "financial_certification_blockers": [],
         },
         freshness_state=FreshnessState.FRESH,
@@ -158,6 +177,10 @@ def connector_status() -> dict:
     items = [
         pipedrive.fetch_users(settings.pipedrive_users_path),
         pipedrive.fetch_stages(settings.pipedrive_stages_path),
-        acumatica.fetch_branches(settings.acumatica_branches_path),
+        # status_snapshot() reports connector state without authenticating.
+        # This previously called fetch_branches(), so every poll of this
+        # endpoint was a fresh Acumatica login. Pipedrive stays as-is: it
+        # authenticates with an API token that has no lockout policy.
+        acumatica.status_snapshot(),
     ]
     return {"read_only": True, "items": items}
