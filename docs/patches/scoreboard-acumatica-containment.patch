index 0000000..412ccba
--- /dev/null
+++ b/backend/scoreboard/connectors/acumatica_cache.py
@@ -0,0 +1,160 @@
+"""Last-known Acumatica payloads, so HTTP routes never need to authenticate.
+
+The rule this exists to enforce: **no inbound HTTP request may cause an
+Acumatica login.** Routes read here; only the refresh job writes here, and only
+the refresh job authenticates.
+
+That inverts the previous arrangement, where a dashboard or monitoring poll went
+straight through to a fresh login. It also means a route can now serve stale
+data — which is why every read carries `as_of` and `age_seconds`, and why a
+cache miss is reported as a miss rather than silently returning an empty list. A
+dashboard showing yesterday's numbers labelled as yesterday's is fine; one
+showing them as today's is not.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+DEFAULT_CACHE_DIR = "/var/lib/scoreboard/acumatica/cache"
+
+
+def cache_dir() -> Path:
+    return Path(os.getenv("SCOREBOARD_ACUMATICA_CACHE_DIR", DEFAULT_CACHE_DIR))
+
+
+class AcumaticaCache:
+    """Read/write last-known payloads by domain name."""
+
+    def __init__(self, directory: Path | None = None) -> None:
+        self.directory = directory or cache_dir()
+
+    def _path(self, domain: str) -> Path:
+        safe = "".join(ch for ch in domain if ch.isalnum() or ch in "-_")
+        return self.directory / f"{safe}.json"
+
+    def write(self, domain: str, payload: dict[str, Any]) -> None:
+        record = dict(payload)
+        record["cached_at"] = datetime.now(timezone.utc).isoformat()
+        try:
+            self.directory.mkdir(parents=True, exist_ok=True)
+            # Write-then-rename so a reader never sees a half-written file.
+            tmp = self._path(domain).with_suffix(".json.tmp")
+            with tmp.open("w", encoding="utf-8") as handle:
+                json.dump(record, handle)
+            tmp.replace(self._path(domain))
+        except OSError:
+            # A cache that cannot be written must not break the refresh job.
+            pass
+
+    def read(self, domain: str) -> dict[str, Any]:
+        """Return the cached payload, or a miss that says so explicitly."""
+        try:
+            with self._path(domain).open("r", encoding="utf-8") as handle:
+                record = json.load(handle)
+        except (OSError, ValueError):
+            now = datetime.now(timezone.utc)
+            return {
+                "read_only": True,
+                "source": "acumatica",
+                "domain": domain,
+                "as_of": now.isoformat(),
+                "records": [],
+                "cache_state": "miss",
+                "fail_state": {
+                    "reason": (
+                        f"No cached Acumatica data for '{domain}'. Routes never authenticate; "
+                        f"run the refresh job to populate the cache."
+                    ),
+                    "source": "acumatica",
+                    "as_of": now.isoformat(),
+                },
+            }
+        record["cache_state"] = "hit"
+        record["age_seconds"] = self._age_seconds(record.get("cached_at"))
+        return record
+
+    @staticmethod
+    def _age_seconds(cached_at: Any) -> float | None:
+        if not isinstance(cached_at, str):
+            return None
+        try:
+            stamp = datetime.fromisoformat(cached_at)
+        except ValueError:
+            return None
+        if stamp.tzinfo is None:
+            stamp = stamp.replace(tzinfo=timezone.utc)
+        return (datetime.now(timezone.utc) - stamp).total_seconds()
+
+
+class CachedAcumaticaReader:
+    """Read-only, cache-backed stand-in for ``AcumaticaClient``.
+
+    Exposes the same read methods, so the KPI layer and every route work
+    unchanged — but it holds no credential, has no opener, and has no code path
+    that can reach the network. That is the point: substituting this in
+    ``_build_dependencies()`` makes "no route authenticates" a property of the
+    object graph rather than a rule each route has to remember.
+
+    ``leadership_flash`` and the financial endpoints reach Acumatica through
+    ``AcumaticaFinancialExtractor``, which only ever calls ``fetch_ar_invoices``.
+    They are covered here too, without touching the KPI code.
+    """
+
+    def __init__(self, cache: AcumaticaCache | None = None, latch_state: dict[str, Any] | None = None) -> None:
+        self.cache = cache or AcumaticaCache()
+        self._latch_state = latch_state or {}
+
+    # --- read interface, mirroring AcumaticaClient ---------------------------
+
+    def fetch_branches(self, path: str) -> dict[str, Any]:  # noqa: ARG002 - interface parity
+        return self.cache.read("branches")
+
+    def fetch_sales_orders(self, path: str, top: int = 200) -> dict[str, Any]:  # noqa: ARG002
+        return self.cache.read("sales_orders")
+
+    def fetch_ar_invoices(self, path: str, top: int = 200) -> dict[str, Any]:  # noqa: ARG002
+        return self.cache.read("ar_invoices")
+
+    def fetch_inventory_dead_stock_candidates(self, path: str, top: int = 200) -> dict[str, Any]:  # noqa: ARG002
+        return self.cache.read("inventory_dead_stock")
+
+    def authenticate(self) -> dict[str, Any]:
+        """Always refuses. A cache-backed reader has no credential to present."""
+        now = datetime.now(timezone.utc)
+        return {
+            "read_only": True,
+            "source": "acumatica",
+            "domain": "auth",
+            "as_of": now.isoformat(),
+            "records": [],
+            "fail_state": {
+                "reason": "Routes never authenticate to Acumatica; this reader serves cached state only.",
+                "source": "acumatica",
+                "as_of": now.isoformat(),
+            },
+        }
+
+    def status_snapshot(self) -> dict[str, Any]:
+        now = datetime.now(timezone.utc)
+        branches = self.cache.read("branches")
+        return {
+            "read_only": True,
+            "source": "acumatica",
+            "domain": "status",
+            "as_of": now.isoformat(),
+            "authenticated": False,
+            "connector_state": "cache_backed_no_authentication",
+            "cache_state": branches.get("cache_state", "miss"),
+            "cache_age_seconds": branches.get("age_seconds"),
+            "auth_latched": bool(self._latch_state.get("latched")),
+            "auth_latch_reason": self._latch_state.get("reason") or None,
+            "note": (
+                "Reported without contacting Acumatica. Routes serve cached last-known "
+                "state; only the refresh job authenticates."
+            ),
+        }
