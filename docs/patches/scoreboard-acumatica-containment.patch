+def test_enabled_flag_defaults_to_disabled(monkeypatch):
+    # Fails closed: anything other than the exact string "true" is off.
+    monkeypatch.delenv("SCOREBOARD_ACUMATICA_ENABLED", raising=False)
+    assert _client(enabled=None).enabled is False
+    for value in ["TRUE", "True", "1", "yes", "on", ""]:
+        monkeypatch.setenv("SCOREBOARD_ACUMATICA_ENABLED", value)
+        assert _client(enabled=None).enabled is False
+    monkeypatch.setenv("SCOREBOARD_ACUMATICA_ENABLED", "true")
+    assert _client(enabled=None).enabled is True
