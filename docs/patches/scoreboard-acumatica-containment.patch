+class _FailureKind(NamedTuple):
+    name: str
+    retryable: bool
+
+
+#: Failure classes are not equivalent, and treating them alike is what turns a
+#: transient blip and a rejected credential into the same code path.
+UNAUTHORIZED = _FailureKind("unauthorized_401", False)
+FORBIDDEN = _FailureKind("forbidden_403", False)
+RATE_LIMITED = _FailureKind("rate_limited_429", True)
+SERVER_ERROR = _FailureKind("server_error_5xx", True)
+TRANSPORT = _FailureKind("transport", True)
+MALFORMED = _FailureKind("malformed_response", False)
+
+#: Ceiling on any server-supplied Retry-After. A cooperative server asking for a
+#: short pause is honoured; one asking us to sleep for an hour inside a request
+#: is not, because that is an outage of our own making.
+MAX_RETRY_AFTER_SECONDS = 30.0
+
+
+def _retry_after_seconds(exc: error.HTTPError) -> float | None:
+    """Parse Retry-After. Seconds form only; HTTP-date form is ignored."""
+    try:
+        raw = exc.headers.get("Retry-After") if exc.headers else None
+    except AttributeError:
+        return None
+    if not raw:
+        return None
+    try:
+        return max(0.0, float(str(raw).strip()))
+    except (TypeError, ValueError):
+        # HTTP-date form. Deliberately not parsed: falling back to normal
+        # backoff is safer than mis-parsing a date into a huge or zero sleep.
+        return None
+
