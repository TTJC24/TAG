diff --git a/tests/test_connectors.py b/tests/test_connectors.py
index 01fe41e..cc8324c 100644
--- a/tests/test_connectors.py
+++ b/tests/test_connectors.py
@@ -1,3 +1,4 @@
+import json
 from backend.scoreboard.connectors.acumatica import AcumaticaClient
 from backend.scoreboard.connectors.pipedrive import PipedriveClient
 
@@ -20,3 +21,123 @@ def test_pipedrive_connector_requires_token():
     assert payload["source"] == "pipedrive"
     assert payload["domain"] == "users"
     assert payload["fail_state"]["state"] == "FAIL"
+
+
+# --- 2026-07-31 lockout containment -----------------------------------------
+# These lock in the behaviour that stopped an Acumatica account lockout. A
+# regression here costs a production ERP account, so they assert the exact
+# number of network calls, not just the outcome.
+
+class _CountingOpener:
+    """Stands in for the urllib opener and counts login attempts."""
+
+    def __init__(self, exc):
+        self.calls = []
+        self._exc = exc
+
+    def open(self, req, timeout=None):  # noqa: A003 - urllib interface
+        self.calls.append(req.full_url)
+        raise self._exc
+
+
+def _client(**kwargs):
+    from backend.scoreboard.connectors.acumatica import AcumaticaClient
+
+    defaults = dict(
+        base_url="https://example.acumatica.com",
+        username="svc",
+        password="secret",
+        company="Production",
+        timeout_seconds=5,
+        auth_path="/entity/auth/login",
+        enabled=True,
+    )
+    defaults.update(kwargs)
+    return AcumaticaClient(**defaults)
+
+
+def _rejection():
+    from urllib import error
+
+    return error.HTTPError(
+        "https://example.acumatica.com/entity/auth/login", 401, "Unauthorized", {}, None
+    )
+
+
+def test_login_is_attempted_exactly_once_not_three_times():
+    # The signature of the lockout: retries=2 fed range(retries+1), and
+    # authenticate() shared the read retry wrapper, so ONE request produced
+    # THREE failed logins.
+    client = _client()
+    opener = _CountingOpener(_rejection())
+    client._opener = opener
+
+    result = client.authenticate()
+
+    assert "fail_state" in result
+    assert len(opener.calls) == 1, f"expected 1 login attempt, got {len(opener.calls)}"
+
+
+def test_data_read_retries_are_unaffected():
+    # Reads still retry; only authentication opted out.
+    client = _client()
+    opener = _CountingOpener(_rejection())
+    client._opener = opener
+    client._authenticated = True  # skip the login path
+    client.backoff_seconds = 0
+
+    client.fetch_branches("/entity/Default/24.200.001/Branch")
+
+    assert len(opener.calls) == 3
+
+
+def test_failed_authentication_latches_for_the_process():
+    # Removing retries alone is not enough: the client is built per HTTP
+    # request, so a polled endpoint would still spend one attempt per poll.
+    client = _client()
+    opener = _CountingOpener(_rejection())
+    client._opener = opener
+
+    client.authenticate()
+    for _ in range(10):
+        result = client.authenticate()
+        assert "fail_state" in result
+
+    assert len(opener.calls) == 1, "a rejected credential must never be presented twice"
+
+
+def test_disabled_connector_never_touches_the_network():
+    client = _client(enabled=False)
+    opener = _CountingOpener(_rejection())
+    client._opener = opener
+
+    assert "fail_state" in client.authenticate()
+    assert "fail_state" in client.fetch_branches("/entity/Default/24.200.001/Branch")
+    assert opener.calls == []
+
+
+def test_enabled_flag_defaults_to_disabled(monkeypatch):
+    # Fails closed: anything other than the exact string "true" is off.
+    monkeypatch.delenv("SCOREBOARD_ACUMATICA_ENABLED", raising=False)
+    assert _client(enabled=None).enabled is False
+    for value in ["TRUE", "True", "1", "yes", "on", ""]:
+        monkeypatch.setenv("SCOREBOARD_ACUMATICA_ENABLED", value)
+        assert _client(enabled=None).enabled is False
+    monkeypatch.setenv("SCOREBOARD_ACUMATICA_ENABLED", "true")
+    assert _client(enabled=None).enabled is True
+
+
+def test_status_snapshot_does_not_authenticate():
+    # The endpoints most likely to be polled must never spend a credential.
+    client = _client()
+    opener = _CountingOpener(_rejection())
+    client._opener = opener
+
+    snapshot = client.status_snapshot()
+
+    assert opener.calls == []
+    assert snapshot["connector_state"] == "not_attempted"
+    assert snapshot["authenticated"] is False
+    # And it discloses no credential material.
+    assert "secret" not in json.dumps(snapshot)
+    assert "svc" not in json.dumps(snapshot)
