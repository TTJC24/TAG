# Database
DATABASE_URL=postgres://company_brain:company_brain@localhost:5432/company_brain

# Embedding provider (gbrain ZeroEntropy switch from Play A)
ZEROENTROPY_API_KEY=

# LLM gateway (gbrain reads ANTHROPIC_API_KEY for ask/expansion)
ANTHROPIC_API_KEY=

# M365 (Microsoft Graph) - reuse Play B app registration if present
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_USER_PRINCIPAL_NAME=

# Acumatica REST contract API
ACUMATICA_BASE_URL=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_TENANT=
ACUMATICA_BRANCH=
ACUMATICA_BRANCH_FS=
ACUMATICA_BRANCH_BLCS=
ACUMATICA_BRANCH_USA=

# Pipedrive
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_API_TOKEN_FS=
PIPEDRIVE_API_TOKEN_BLCS_USA=
PIPEDRIVE_COMPANY_DOMAIN=

# Layer 5 — Supermemory feedback loop
# Get your key at https://supermemory.ai
SUPERMEMORY_API_KEY=

# HTTP API
COMPANY_BRAIN_API_TOKEN=dev-local-token
COMPANY_BRAIN_API_PORT=4317

# Scheduler
SCHEDULER_ENABLED=false
