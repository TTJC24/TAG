# Local development values only. Do not place production credentials here.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
API_PORT=3001
DEV_USER_EMAIL=executive@local.operating-layer
DEFAULT_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001

POSTGRES_DB=operating_layer
POSTGRES_USER=operating_layer
POSTGRES_PASSWORD=local-development-only
# Migration/admin identity; never use for an API or worker process.
MIGRATION_DATABASE_URL=postgresql://operating_layer:local-development-only@localhost:5432/operating_layer
# Non-owner runtime identity; API and worker refuse an RLS-bypassing identity.
DATABASE_URL=postgresql://operating_layer_runtime:local-runtime-only@localhost:5432/operating_layer

REDIS_URL=redis://localhost:6379

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=operating-layer-local
OBJECT_STORAGE_ACCESS_KEY=local-development
OBJECT_STORAGE_SECRET_KEY=local-development-only

# Production authentication is intentionally unconfigured.
AUTH_MODE=local
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=
OIDC_JWKS_URI=
GOOGLE_WORKSPACE_DOMAIN=

# Model providers are intentionally unconfigured.
MODEL_PROVIDER=deterministic
MODEL_SECRET_REFERENCE=

WORKER_ID=local-worker
WORKER_POLL_INTERVAL_MS=1000
# Default internal provider. Gmail draft transport has a separate gate below.
EXECUTION_PROVIDER=deterministic_internal
# Second runtime gate for the Gmail drafts.create transport. Keep false unless
# a separately reviewed organization config, credential, and allowlist exist.
GMAIL_DRAFT_NETWORK_ENABLED=false
