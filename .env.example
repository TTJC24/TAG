# company-brain environment variables.
# Two tiers: the minimum keys needed to boot in fixture-only mode, and the
# live-connector keys you fill in only when you wire real data sources.

# === MINIMUM TO BOOT (fixture-only mode) ===
# These five are all you need to run `bun run ingest:fixtures`,
# `bun run ask`, and `bun run smoke` end-to-end against stub fixtures.

# Database
DATABASE_URL=postgres://company_brain:company_brain@localhost:5432/company_brain

# Embedding provider (gbrain ZeroEntropy switch from Play A)
# Get a key at https://zeroentropy.dev/
ZEROENTROPY_API_KEY=

# LLM gateway (gbrain reads ANTHROPIC_API_KEY for ask/expansion)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# HTTP API
COMPANY_BRAIN_API_TOKEN=dev-local-token
COMPANY_BRAIN_API_PORT=4317

# === LIVE CONNECTORS (fill only when wiring real data) ===
# Leave these blank to stay in fixture-only mode.

# M365 (Microsoft Graph) - reuse Play B app registration if present
# Reuse the Play B Azure app registration; tenant + client id + secret from Azure Portal -> App registrations
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_USER_PRINCIPAL_NAME=

# Acumatica REST contract API
ACUMATICA_BASE_URL=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_TENANT=
# ACUMATICA_BRANCH* values MUST match the Acumatica branch IDs exactly
# (case-sensitive). The per-entity vars feed the `PX-CbApiBranch` header
# on every request — a wrong value silently returns a different branch's
# data instead of failing loudly. Don't use shorthand: use the real
# branch ID (e.g. `BLC`, not `bl`).
ACUMATICA_BRANCH=
ACUMATICA_BRANCH_FS=
ACUMATICA_BRANCH_BLCS=
ACUMATICA_BRANCH_USA=

# Pipedrive
# Settings -> Personal preferences -> API in Pipedrive web UI
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_API_TOKEN_FS=
PIPEDRIVE_API_TOKEN_BLCS_USA=
PIPEDRIVE_COMPANY_DOMAIN=

# Layer 5 — Supermemory feedback loop
# Get your key at https://supermemory.ai
SUPERMEMORY_API_KEY=

# Scheduler
SCHEDULER_ENABLED=false
