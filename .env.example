BRANCH_ENTITY_MAPPING_JSON={"FS":"FS","BL":"BL"}
REP_MAPPING_JSON={"Tim Clark":"Tim Clark","Nicholas Dorfmueller":"Nicholas Dorfmueller","Daniel Milavickas":"Daniel Milavickas","Mike Grant":"Mike Grant","Jeff Woods":"Jeff Woods","Tyler Shinn":"Tyler Shinn","Michael Stewart":"Michael Stewart","Scott Segal":"Scott Segal","Andrew sutt":"Andrew sutt","chris coghlan":"chris coghlan","Bill Potts":"Bill Potts","Cody Braden":"Cody Braden"}
