# ─────────────────────────────────────────────────────────────────────────────
# TractionOS — environment variables
# Copy this file to .env.local for local dev. Do not commit .env.local.
# Each external service has its own step in the Phase 1 plan; this file lists
# everything the app reads at runtime so you can provision in one pass.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (Neon) ──────────────────────────────────────────────────────────
# Pooled connection string from the Neon console (preferred for serverless).
DATABASE_URL=

# ── Clerk (Step 4) ────────────────────────────────────────────────────────────
# Enable "Organizations" in the Clerk dashboard before generating these keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: customize sign-in / sign-up paths in Clerk dashboard, then mirror here.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Liveblocks (Step 5) ───────────────────────────────────────────────────────
LIVEBLOCKS_SECRET_KEY=
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# ── LLM providers (Step 6, Phase 6) ──────────────────────────────────────────
# Free-tier only. See ADR-0010. Speech-to-text is the browser-native Web Speech
# API and needs no key.
#
# Google AI Studio — Gemini 2.5 Flash. Free at https://aistudio.google.com.
# 1,500 requests/day free. Default for transcript (batch) workloads.
GOOGLE_AI_API_KEY=
# Groq — Llama 3.3 70B. Free at https://console.groq.com. 14,400 requests/day
# free. Default for voice copilot (latency-sensitive).
GROQ_API_KEY=

# ── Resend (Step 7) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# The verified domain (or onboarding@resend.dev for dev).
RESEND_FROM=

# ── Microsoft Graph + MSAL (Step 8) ──────────────────────────────────────────
# Daemon (client-credentials) flow. App registration in Entra ID needs admin
# consent for: Chat.ReadWrite, OnlineMeetings.Read.All,
# OnlineMeetingTranscript.Read.All.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Fireflies (Step 9) ────────────────────────────────────────────────────────
FIREFLIES_API_KEY=
# Set on the webhook in Fireflies workspace settings; we verify it on receive.
FIREFLIES_WEBHOOK_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL for absolute links in emails, Teams cards, webhook configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
